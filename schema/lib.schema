{}
;; signal-message — ordinary working wire contract for message ingress.
;;
;; Wire-only: emits the rkyv + optional DOTOS codec and the signal-frame
;; request/reply envelope. Runtime provenance stamping, socket binding,
;; router forwarding, and durable state live in the message and router
;; daemons.
;;
;; Agent identity + delivery registry vocabulary: the ORCHESTRATOR is the
;; mint — it allocates the short identifier before the process starts — and
;; the messenger's registry is the durable consumer view of identity.
;; `AssignAgentIdentity` seats an orchestrator-supplied identity (fresh, or
;; reseated on resume/respawn); `BindAgentEndpoint` updates the live
;; delivery endpoint; `QueryAgentRegistry` reads the durable registry.
;;
;; Thread vocabulary (messenger promotion, packet 3.1): threads are plain
;; sender-chosen names — no minting ceremony. A thread MAY carry an optional
;; relation to what is being worked on (repository + feature branch — the
;; orchestrator lane name IS the branch name); the relation is optional and
;; uncommitted per the recorded design hedge. Thread participants accumulate
;; automatically (the sender and recipient of every thread-tagged submission)
;; and by explicit `SubscribeThread`; sending to a thread name reaches every
;; participant in one go. Every stored message carries its origin; inbox and
;; thread entries expose the resolved sender.
;;
;; `Error` mirrors the daemon-local error projection so the contract Output
;; and the daemon's own Output stay index-aligned end to end (the structural
;; convergence the reply-reliability work depends on).
;;
;; SELF-CONTAINED VOCABULARY. This schema defines the wire vocabulary locally.
;; Daemons project these local wire nouns into their internal provenance/runtime
;; nouns at the boundary.

[Submit.MessageSubmission
 SubmitStamped.StampedMessageSubmission
 QueryInbox.InboxQuery
 AssignAgentIdentity.AgentIdentityAssignment
 BindAgentEndpoint.AgentEndpointBinding
 QueryAgentRegistry.AgentRegistryQuery
 QueryThread.ThreadQuery
 SubscribeThread.ThreadSubscription
 QueryThreads.ThreadIndexQuery]
[SubmissionAccepted.SubmissionAcceptance
 SubmissionRejected.SubmissionRejection
 InboxListing.InboxListingReply
 AgentIdentityAssigned.AssignedAgentIdentity
 AgentEndpointBound.BoundAgentEndpoint
 AgentRegistryListing.AgentRegistryListingReply
 AgentRegistryRejected.AgentRegistryRejection
 MessageRequestUnimplemented.MessageRequestUnimplementedReply
 Error.ErrorReport
 ThreadListing.ThreadContents
 ThreadSubscribed.ThreadSubscriptionAcknowledgment
 ThreadIndexListing.ThreadIndexEntries
 ThreadRejected.ThreadRejection]
{
  MessageRecipient.String
  MessageSender.String
  MessageBody.String
  MessageSlot.Integer
  TimestampNanos.Integer
  WirePath.String
  SocketMode.Integer
  UnixUserIdentifier.Integer
  SystemPrincipal.String
  EngineIdentifier.String
  HostName.String
  NetworkPeer.String
  ComponentInstanceName.String

  MessageKind.[Send Inbox]

  ThreadName.String
  ThreadSelection.[None Named.ThreadName]

  MessageSubmission.{
    MessageRecipient
    MessageKind
    MessageBody
    ThreadSelection
  }

  Host.HostName
  OtherPersonaEngine.{
    EngineIdentifier
    Host
  }
  ConnectionClass.[
    Owner
    NonOwnerUser.UnixUserIdentifier
    System.SystemPrincipal
    OtherPersona.OtherPersonaEngine
    Network.NetworkPeer
  ]
  ComponentName.[Mind Message Router Terminal Harness System Introspect Orchestrate Spirit]
  InternalComponentInstanceOrigin.{
    ComponentName
    ComponentInstanceName
  }
  MessageOrigin.[
    Internal.ComponentName
    InternalComponentInstance.InternalComponentInstanceOrigin
    External.ConnectionClass
  ]

  StampedAt.TimestampNanos
  StampedMessageSubmission.{
    MessageSubmission
    MessageOrigin
    StampedAt
  }

  IngressSocketPath.WirePath
  ComponentMessageIngress.{
    InternalComponentInstanceOrigin
    IngressSocketPath
    SocketMode
  }

  SubmissionAcceptance.MessageSlot
  InboxQuery.MessageRecipient
  MessageOperationKind.[Submit SubmitStamped QueryInbox AssignAgentIdentity BindAgentEndpoint QueryAgentRegistry QueryThread SubscribeThread QueryThreads]

  AgentIdentifier.String
  HarnessPid.Integer
  HarnessStartTime.Integer
  ResumeIdentity.String
  ResumeSelection.[None Resumed.ResumeIdentity]

  AgentEndpointKind.[PtySocket HarnessSocket]
  EndpointPath.WirePath
  AgentEndpoint.{
    AgentEndpointKind
    EndpointPath
  }
  EndpointSelection.[None Bound.AgentEndpoint]
  AgentDeathMark.[NotDead Killed]

  HarnessProcessPin.{
    HarnessPid
    HarnessStartTime
  }
  ProcessPinSelection.[None Pinned.HarnessProcessPin]

  AgentIdentityAssignment.{
    AgentIdentifier
    ProcessPinSelection
    ResumeSelection
  }
  IdentityProvenance.[Seated Reseated]
  AssignedAgentIdentity.{
    AgentIdentifier
    IdentityProvenance
  }

  AgentEndpointBinding.{
    AgentIdentifier
    AgentEndpoint
    HarnessPid
    HarnessStartTime
  }
  BoundAgentEndpoint.AgentIdentifier

  AgentRegistryQuery.[All ByAgent.AgentIdentifier]
  AgentRegistryEntry.{
    AgentIdentifier
    EndpointSelection
    ResumeSelection
    AgentDeathMark
    ProcessPinSelection
  }
  AgentRegistryListingReply.{ Entries.Vector.AgentRegistryEntry }
  AgentRegistryRejectionReason.[UnknownAgentIdentifier StoreRejected]
  AgentRegistryRejection.AgentRegistryRejectionReason
  InboxEntry.{
    MessageSlot
    MessageSender
    MessageBody
    ThreadSelection
    StampedAt
  }
  InboxListingReply.{ Messages.Vector.InboxEntry }
  SubmissionRejectionReason.[StoreRejected RecipientNotFound]
  SubmissionRejection.SubmissionRejectionReason

  ErrorMessage.String
  ErrorReport.ErrorMessage

  ThreadQuery.ThreadName
  RepositoryName.String
  FeatureBranchName.String
  ThreadRelation.{
    RepositoryName
    FeatureBranchName
  }
  ThreadRelationSelection.[None Related.ThreadRelation]
  ParticipantName.String
  ThreadSubscription.{
    ThreadName
    ParticipantName
    ThreadRelationSelection
  }
  ThreadSubscriptionAcknowledgment.{
    ThreadName
    ParticipantName
  }
  ThreadEntry.{
    MessageSlot
    MessageSender
    MessageBody
    StampedAt
  }
  Participants.Vector.ParticipantName
  ThreadEntries.Vector.ThreadEntry
  ThreadContents.{
    ThreadName
    ThreadRelationSelection
    Participants
    ThreadEntries
  }
  ThreadIndexQuery.[All]
  MessageCount.Integer
  ThreadSummary.{
    ThreadName
    ThreadRelationSelection
    Participants
    MessageCount
  }
  ThreadIndexEntries.{ Threads.Vector.ThreadSummary }
  ThreadRejectionReason.[UnknownThread StoreRejected]
  ThreadRejection.ThreadRejectionReason

  DependencyKind.[Router Mind Harness Terminal]
  ResourceKind.[MessageSocket RouterSocket PeerCredentials Store]
  MessageUnimplementedReason.[
    NotInPrototypeScope
    DependencyMissing.DependencyKind
    ResourceUnavailable.ResourceKind
  ]
  MessageRequestUnimplementedReply.{
    MessageOperationKind
    MessageUnimplementedReason
  }

  OwnerIdentity.[
    UnixUser.UnixUserIdentifier
    System.SystemPrincipal
  ]

  MessageSocketPath.WirePath
  MessageSocketMode.SocketMode
  SupervisionSocketPath.WirePath
  SupervisionSocketMode.SocketMode
  RouterSocketPath.WirePath
  MessageDaemonConfiguration.{
    MessageSocketPath
    MessageSocketMode
    SupervisionSocketPath
    SupervisionSocketMode
    RouterSocketPath
    ComponentIngresses.Vector.ComponentMessageIngress
    OwnerIdentity
  }
}
