;; signal-message — ordinary working wire contract for message ingress.
;;
;; Wire-only: emits the rkyv + optional NOTA codec and the signal-frame
;; request/reply envelope. Runtime provenance stamping, socket binding,
;; router forwarding, and durable state live in the message and router
;; daemons.
;;
;; Agent identity + delivery registry vocabulary: the messenger owns the
;; authoritative process<->ID map. `AssignAgentIdentity` is the launch-time
;; mint (new or reused-on-resume short identifier); `BindAgentEndpoint`
;; updates the live delivery endpoint; `QueryAgentRegistry` reads the
;; durable registry.
;;
;; SELF-CONTAINED VOCABULARY. This schema defines the wire vocabulary locally.
;; Daemons project these local wire nouns into their internal provenance/runtime
;; nouns at the boundary.

[(Submit MessageSubmission)
 (SubmitStamped StampedMessageSubmission)
 (QueryInbox InboxQuery)
 (AssignAgentIdentity AgentIdentityAssignment)
 (BindAgentEndpoint AgentEndpointBinding)
 (QueryAgentRegistry AgentRegistryQuery)]
[(SubmissionAccepted SubmissionAcceptance)
 (SubmissionRejected SubmissionRejection)
 (InboxListing InboxListing)
 (AgentIdentityAssigned AssignedAgentIdentity)
 (AgentEndpointBound BoundAgentEndpoint)
 (AgentRegistryListing AgentRegistryListing)
 (AgentRegistryRejected AgentRegistryRejection)
 (MessageRequestUnimplemented MessageRequestUnimplemented)]
{
  MessageRecipient String
  MessageSender String
  MessageBody String
  MessageSlot Integer
  TimestampNanos Integer
  WirePath String
  SocketMode Integer
  UnixUserIdentifier Integer
  SystemPrincipal String
  EngineIdentifier String
  HostName String
  NetworkPeer String
  ComponentInstanceName String

  MessageKind [Send Inbox]

  ThreadName String
  ThreadSelection [None (Named ThreadName)]

  MessageSubmission {
    MessageRecipient
    MessageKind
    MessageBody
    ThreadSelection
  }

  Host HostName
  OtherPersonaEngine {
    EngineIdentifier
    Host
  }
  ConnectionClass [
    Owner
    (NonOwnerUser UnixUserIdentifier)
    (System SystemPrincipal)
    (OtherPersona OtherPersonaEngine)
    (Network NetworkPeer)
  ]
  ComponentName [Mind Message Router Terminal Harness System Introspect Orchestrate Spirit]
  InternalComponentInstanceOrigin {
    ComponentName
    ComponentInstanceName
  }
  MessageOrigin [
    (Internal ComponentName)
    (InternalComponentInstance InternalComponentInstanceOrigin)
    (External ConnectionClass)
  ]

  StampedAt TimestampNanos
  StampedMessageSubmission {
    MessageSubmission
    MessageOrigin
    StampedAt
  }

  IngressSocketPath WirePath
  ComponentMessageIngress {
    InternalComponentInstanceOrigin
    IngressSocketPath
    SocketMode
  }

  SubmissionAcceptance MessageSlot
  InboxQuery MessageRecipient
  MessageOperationKind [Submit SubmitStamped QueryInbox AssignAgentIdentity BindAgentEndpoint QueryAgentRegistry]

  AgentIdentifier String
  HarnessPid Integer
  HarnessStartTime Integer
  ResumeIdentity String
  ResumeSelection [None (Resumed ResumeIdentity)]

  AgentEndpointKind [PtySocket HarnessSocket]
  EndpointPath WirePath
  AgentEndpoint {
    AgentEndpointKind
    EndpointPath
  }
  EndpointSelection [None (Bound AgentEndpoint)]
  AgentDeathMark [NotDead Killed]

  AgentIdentityAssignment {
    HarnessPid
    HarnessStartTime
    ResumeSelection
  }
  IdentityProvenance [Minted Reused]
  AssignedAgentIdentity {
    AgentIdentifier
    IdentityProvenance
  }

  AgentEndpointBinding {
    AgentIdentifier
    AgentEndpoint
    HarnessPid
    HarnessStartTime
  }
  BoundAgentEndpoint AgentIdentifier

  AgentRegistryQuery [All (ByAgent AgentIdentifier)]
  AgentRegistryEntry {
    AgentIdentifier
    EndpointSelection
    ResumeSelection
    AgentDeathMark
    HarnessPid
    HarnessStartTime
  }
  AgentRegistryListing { Entries.(Vector AgentRegistryEntry) }
  AgentRegistryRejectionReason [UnknownAgentIdentifier IdentifierSpanExhausted StoreRejected]
  AgentRegistryRejection AgentRegistryRejectionReason
  InboxEntry {
    MessageSlot
    MessageSender
    MessageBody
  }
  InboxListing { Messages.(Vector InboxEntry) }
  SubmissionRejectionReason [StoreRejected RecipientNotFound]
  SubmissionRejection SubmissionRejectionReason

  DependencyKind [Router Mind Harness Terminal]
  ResourceKind [MessageSocket RouterSocket PeerCredentials Store]
  MessageUnimplementedReason [
    NotInPrototypeScope
    (DependencyMissing DependencyKind)
    (ResourceUnavailable ResourceKind)
  ]
  MessageRequestUnimplemented {
    MessageOperationKind
    MessageUnimplementedReason
  }

  OwnerIdentity [
    (UnixUser UnixUserIdentifier)
    (System SystemPrincipal)
  ]

  MessageSocketPath WirePath
  MessageSocketMode SocketMode
  SupervisionSocketPath WirePath
  SupervisionSocketMode SocketMode
  RouterSocketPath WirePath
  MessageDaemonConfiguration {
    MessageSocketPath
    MessageSocketMode
    SupervisionSocketPath
    SupervisionSocketMode
    RouterSocketPath
    ComponentIngresses.(Vector ComponentMessageIngress)
    OwnerIdentity
  }
}
