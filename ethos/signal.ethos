; Message forwards Flow's public request id and sender-filtered status stream.
; The socket peer is the authenticated sender.
; Configure sets the ordinary, Meta and Flow socket paths. An ordinary
; Configure is refused after Meta Configure has been accepted.

Signal
[ signal_flow:[ Address Process Lock SendPayloadSize SendRequest VisibleSendAcceptance
                VisibleDeliverySnapshot VisibleSendObservation DeliveryCursor NativeSessionId
                VisibleSendReceipt VisibleSendFailure ]
  message_library:Configuration ]
[ Send.SendRequest
  SendThread.{ SendRequest NativeSessionId }
  ObserveSends.Option<DeliveryCursor>
  ObserveThread.{ Option<DeliveryCursor> NativeSessionId }
  Configure.Configuration ]
[ Sent.VisibleSendReceipt
  Failed.VisibleSendFailure
  SendAccepted.VisibleSendAcceptance
  SendsObserved.VisibleSendObservation
  SendChanged.VisibleDeliverySnapshot
  ObservationInterrupted.{ Option<DeliveryCursor> String }
  Configured
  Refused.SendRefusal ]
[ SendRefusal.[ Unidentified.Process
  Unknown.[ Address Lock ]
  Ended.Address
  Asleep
  NoneAbove
  OffRoute
  Held.Lock
  Locked
  Lapsed
  NotMessage
  NoLayer
  Store.String
  FlowUnreachable
  AlreadyConfigured
  NotConfigured
  NotSendServer.Process
  Oversized.SendPayloadSize
  FlowProtocolMismatch ] ]
