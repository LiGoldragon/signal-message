; Message forwards Flow's durable logical delivery and exposes its
; sender-filtered status stream. The socket peer is the authenticated sender.
; Configure sets the ordinary, Meta and Flow socket paths. An ordinary
; Configure is refused after Meta Configure has been accepted.

Signal
[ signal_flow:[ Address Process Lock SendPayloadSize SendRequest SendAcceptance DeliverySnapshot
                SendObservation DeliveryCursor NativeSessionId ]
  message_library:Configuration ]
[ Send.SendRequest
  SendThread.{ SendRequest NativeSessionId }
  ObserveSends.Option<DeliveryCursor>
  ObserveThread.{ Option<DeliveryCursor> NativeSessionId }
  Configure.Configuration ]
[ SendAccepted.SendAcceptance
  SendsObserved.SendObservation
  SendChanged.DeliverySnapshot
  ObservationInterrupted.{ Option<DeliveryCursor> String }
  Configured
  Refused.SendRefusal ]
[ SendRefusal.[ Unidentified.Process
  Unknown.[ Address.Address Lock.Lock ]
  Ended.Address
  Asleep
  NoneAbove
  OffRoute
  Held.Lock
  Locked
  Lapsed
  NotMessage
  NoLayer
  Store.String
  FlowUnreachable
  AlreadyConfigured
  NotConfigured
  NotSendServer.Process
  Oversized.SendPayloadSize ] ]
